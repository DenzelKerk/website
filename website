function renderCart(){document.getElementById('cart-count').textContent=cart.reduce((a,x)=>a+x.qty,0);document.getElementById('cart-caption').textContent='/ '+cart.reduce((a,x)=>a+x.qty,0)+' items';document.getElementById('cart-items').innerHTML=cart.length?cart.map(x=>`<div class="cart-item"><div>${x.name}<small>${x.qty} × ${fmt(x.price)}</small></div><div>${fmt(x.qty*x.price)} <button class="remove" data-remove="${x.id}" aria-label="Remove ${x.name}">×</button></div></div>`).join(''):'<div class="empty-cart">Your cart is ready for a good idea.</div>';document.getElementById('cart-total').textContent=fmt(cart.reduce((a,x)=>a+x.price*x.qty,0))}
function toggleCart(on){document.getElementById('cart').classList.toggle('open',on);document.getElementById('scrim').classList.toggle('open',on);document.getElementById('cart').setAttribute('aria-hidden',String(!on))}let toastTimer;function toast(text){const t=document.getElementById('toast');t.textContent=text;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),1900)}
document.addEventListener('click',e=>{const f=e.target.closest('[data-filter]');if(f){document.querySelectorAll('.filter').forEach(x=>x.classList.remove('active'));f.classList.add('active');renderProducts(f.dataset.filter)}const add=e.target.closest('[data-add]');if(add){const p=products.find(x=>x.id===add.dataset.add),old=cart.find(x=>x.id===p.id);old?old.qty++:cart.push({...p,qty:1});renderCart();toast(p.name+' added to cart')}const rm=e.target.closest('[data-remove]');if(rm){cart=cart.filter(x=>x.id!==rm.dataset.remove);renderCart()}});document.getElementById('cart-open').onclick=()=>toggleCart(true);document.getElementById('cart-close').onclick=()=>toggleCart(false);document.getElementById('scrim').onclick=()=>toggleCart(false);document.getElementById('checkout').onclick=()=>{if(!cart.length){toast('Add a product to get started');return}toast('Checkout setup coming soon — message us to order');};document.getElementById('contact-form').addEventListener('submit',e=>{e.preventDefault();const d=new FormData(e.currentTarget),subject=encodeURIComponent('Zeltech inquiry: '+d.get('topic')),body=encodeURIComponent('Name: '+d.get('name')+'\nEmail: '+d.get('email')+'\nTopic: '+d.get('topic')+'\n\n'+d.get('message'));window.location.href='mailto:yasuicide600@gmail.com?subject='+subject+'&body='+body;toast('Opening your email app')});renderProducts();renderCart();
</script>
