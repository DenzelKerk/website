const products=[
{id:'uno',sku:'BOARD / 001',name:'Arduino Uno R3 Starter Set',desc:'The classic board, ready for your first build.',price:890,category:'boards',tag:'BESTSELLER',mark:'UNO R3'},
{id:'esp32',sku:'BOARD / 002',name:'ESP32 Wi-Fi + Bluetooth Dev Board',desc:'Dual-core wireless power for connected projects.',price:420,category:'boards',tag:'WIRELESS',mark:'ESP32'},
{id:'sensor',sku:'SENSOR / 013',name:'Precision Sensor Pack',desc:'Temperature, light, motion & distance modules.',price:560,category:'components',tag:'4-IN-1',mark:'SENSE'},
